generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SupportStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@map("support_status")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requestedRelationships SupportRelationship[] @relation("Requester")
  supportedRelationships SupportRelationship[] @relation("Supporter")

  @@map("users")
}

model SupportRelationship {
  id          Int          @id @default(autoincrement())
  requesterId Int
  supporterId Int
  status      SupportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  requester User @relation("Requester", fields: [requesterId], references: [id])
  supporter User @relation("Supporter", fields: [supporterId], references: [id])

  @@map("support_relationships")
}
